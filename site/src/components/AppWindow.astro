---
// The demo's first frame as static HTML: shown until React takes over, and without JavaScript.
---

<div class="window" role="img" aria-label="The ghl window: a file tree, and a diff of web/src/stack.ts with a comment on line 11">
  <div class="titlebar">
    <div class="lights" aria-hidden="true"><span></span><span></span><span></span></div>
    <div class="capsule">
      <span class="layer">2/3</span>
      <span>main</span><span class="faint">←</span><span>stack-nav</span>
    </div>
    <div class="actions">
      <span class="optional pr">
        <svg class="pr-open" viewBox="0 0 16 16" aria-hidden="true"><path d="M1.5 3.25a2.25 2.25 0 1 1 3 2.122v5.256a2.251 2.251 0 1 1-1.5 0V5.372A2.25 2.25 0 0 1 1.5 3.25Zm5.677-.177L9.573.677A.25.25 0 0 1 10 .854V2.5h1A2.5 2.5 0 0 1 13.5 5v5.628a2.251 2.251 0 1 1-1.5 0V5a1 1 0 0 0-1-1h-1v1.646a.25.25 0 0 1-.427.177L7.177 3.427a.25.25 0 0 1 0-.354ZM3.75 2.5a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5Zm0 9.5a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5Zm8.25.75a.75.75 0 1 0 1.5 0 .75.75 0 0 0-1.5 0Z"></path></svg>#211
        <span class="pr-signal"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 16A8 8 0 1 1 8 0a8 8 0 0 1 0 16Zm3.78-9.72a.751.751 0 0 0-.018-1.042.751.751 0 0 0-1.042-.018L6.75 9.19 5.28 7.72a.751.751 0 0 0-1.042.018.751.751 0 0 0-.018 1.042l2 2a.75.75 0 0 0 1.06 0Z"></path></svg></span>
      </span>
      <span class="optional">Comments <span class="count">1</span></span>
      <span class="optional">Copy</span>
    </div>
  </div>
  <div class="body">
    <div class="tree">
      <div class="dir">▾ docs</div>
      <div class="file viewed">reviewing.md<span class="m">M</span></div>
      <div class="dir">▾ go/internal/app</div>
      <div class="file viewed">stack.go<span class="m">M</span></div>
      <div class="dir">▾ web/src</div>
      <div class="file on">stack.ts<span class="m">M</span></div>
    </div>
    <div class="pane">
      <div class="card folded"><div class="header">docs/reviewing.md<span class="viewed"><span class="box on"></span> Viewed</span></div></div>
      <div class="card folded"><div class="header">go/internal/app/stack.go<span class="viewed"><span class="box on"></span> Viewed</span></div></div>
      <div class="card">
        <div class="header">
          web/src/stack.ts <span class="plus">+3</span><span class="minus">−2</span>
          <span class="viewed"><span class="box"></span> Viewed</span>
        </div>
        <div class="lines">
          <div class="ln"><span class="no">8</span><span class="sg"></span>export function layerAbove(stack: Layer[], branch: string) &#123;</div>
          <div class="ln del"><span class="no">9</span><span class="sg">−</span>  const index = stack.findIndex((layer) =&gt; layer.branch === branch)</div>
          <div class="ln del"><span class="no">10</span><span class="sg">−</span>  return stack[index - 1]</div>
          <div class="ln add"><span class="no">9</span><span class="sg">+</span>  const live = stack.filter((layer) =&gt; !layer.merged)</div>
          <div class="ln add"><span class="no">10</span><span class="sg">+</span>  const index = live.findIndex((layer) =&gt; layer.branch === branch)</div>
          <div class="ln add"><span class="no">11</span><span class="sg">+</span>  return index &gt; 0 ? live[index - 1] : undefined</div>
          <div class="note">
            <div class="who"><b>You</b> on L11<span class="resolve">Resolve</span></div>
            Return <code>null</code> here, like <code>layerBelow</code> does.
          </div>
          <div class="ln"><span class="no">12</span><span class="sg"></span>&#125;</div>
        </div>
      </div>
    </div>
  </div>
  <div class="status">
    <span>Base main · from gh stack</span><span>3 files · +7 −3</span><span>2 of 3 viewed</span>
  </div>
</div>

<style>
  .pr {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--text);
    font: 600 12px var(--mono);
  }

  .pr svg {
    width: 14px;
    height: 14px;
    fill: currentColor;
  }

  .pr-open {
    color: var(--green);
  }

  .pr-signal {
    display: flex;
    padding-left: 6px;
    border-left: 1px solid var(--border);
    color: var(--green);
  }

  .card {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--win-card);
  }

  .card + .card {
    margin-top: 16px;
  }

  .folded .header {
    border-bottom: 0;
  }

  .box.on {
    border-color: var(--accent);
    background: var(--accent);
  }

  .file.viewed {
    color: var(--faint);
  }

  .header {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 40px;
    padding: 0 12px;
    border-bottom: 1px solid var(--border);
    font: 600 12.5px var(--mono);
  }

  .plus {
    color: var(--green);
  }

  .minus {
    color: var(--red);
  }

  .viewed {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-left: auto;
    color: var(--dim);
    font: 500 12px var(--sans);
  }

  .box {
    width: 13px;
    height: 13px;
    border: 1px solid var(--border-strong);
    border-radius: 3px;
    background: var(--win-card);
  }

  .lines {
    padding: 6px 0;
    overflow-x: auto;
  }

  .ln {
    display: flex;
    color: var(--code-text);
    font: 12.5px/22px var(--mono);
    white-space: pre;
  }

  .no {
    flex-shrink: 0;
    width: 40px;
    padding-right: 8px;
    color: var(--faint);
    text-align: right;
  }

  .sg {
    flex-shrink: 0;
    width: 18px;
    color: var(--faint);
    text-align: center;
  }

  .add {
    background: var(--diff-add);
  }

  .add .no {
    background: var(--diff-add-number);
  }

  .del {
    background: var(--diff-del);
  }

  .del .no {
    background: var(--diff-del-number);
  }

  .note {
    margin: 8px 16px 8px 58px;
    padding: 12px 14px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--win-note);
    box-shadow: 0 2px 8px rgb(0 0 0 / 6%);
    font-size: 13px;
    line-height: 1.5;
  }

  .note code {
    font-size: 12px;
  }

  .who {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-bottom: 4px;
    color: var(--dim);
    font-size: 12px;
  }

  .resolve {
    margin-left: auto;
    padding: 3px 9px;
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    background: var(--raised);
    font-weight: 500;
  }

  .who b {
    color: var(--text);
  }
</style>

---
// A static replica of the ghl window, reviewing one layer of a stack.
---

<div class="window" role="img" aria-label="The ghl window: a file tree, and a diff of web/src/stack.ts with a comment on line 15">
  <div class="titlebar">
    <div class="lights" aria-hidden="true"><span></span><span></span><span></span></div>
    <div class="capsule">
      <span class="layer">2/3</span>
      <span>main</span><span class="faint">←</span><span>stack-nav</span>
    </div>
    <div class="actions">
      <span>Comments <span class="count">1</span></span>
      <span>Copy</span>
    </div>
  </div>
  <div class="body">
    <div class="tree">
      <div class="dir">▾ docs</div>
      <div class="file">reviewing.md<span class="m">M</span></div>
      <div class="dir">▾ go/internal/app</div>
      <div class="file">stack.go<span class="m">M</span></div>
      <div class="dir">▾ web/src</div>
      <div class="file on">stack.ts<span class="m">M</span></div>
      <div class="file">StackPicker.tsx<span class="a">A</span></div>
    </div>
    <div class="pane">
      <div class="card">
        <div class="header">
          web/src/stack.ts <span class="plus">+3</span><span class="minus">−2</span>
          <span class="viewed"><span class="box"></span> Viewed</span>
        </div>
        <div class="lines">
          <div class="ln"><span class="no">12</span><span class="sg"></span>export function layerAbove(stack: Layer[], branch: string) &#123;</div>
          <div class="ln del"><span class="no">13</span><span class="sg">−</span>  const index = stack.findIndex((layer) =&gt; layer.branch === branch)</div>
          <div class="ln del"><span class="no">14</span><span class="sg">−</span>  return stack[index - 1]</div>
          <div class="ln add"><span class="no">13</span><span class="sg">+</span>  const live = stack.filter((layer) =&gt; !layer.merged)</div>
          <div class="ln add"><span class="no">14</span><span class="sg">+</span>  const index = live.findIndex((layer) =&gt; layer.branch === branch)</div>
          <div class="ln add"><span class="no">15</span><span class="sg">+</span>  return index &gt; 0 ? live[index - 1] : undefined</div>
          <div class="note">
            <div class="who"><b>You</b> on L15</div>
            Return <code>null</code> here, like <code>layerBelow</code> does.
          </div>
          <div class="ln"><span class="no">16</span><span class="sg"></span>&#125;</div>
        </div>
      </div>
    </div>
  </div>
  <div class="status">
    <span>Base main · from gh stack</span><span>4 files · +42 −9</span><span>1 of 4 viewed</span>
  </div>
</div>

<style>
  .window {
    overflow: hidden;
    border: 1px solid var(--border-strong);
    border-radius: 12px;
    background: var(--win);
    box-shadow: var(--win-shadow);
  }

  .titlebar {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 52px;
    padding: 0 14px;
    border-bottom: 1px solid var(--border);
    background: var(--win-chrome);
  }

  .lights {
    display: flex;
    gap: 8px;
  }

  .lights span {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #ff5f57;
  }

  .lights span:nth-child(2) {
    background: #febc2e;
  }

  .lights span:nth-child(3) {
    background: #28c840;
  }

  .capsule {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 30px;
    margin: 0 auto;
    padding: 0 12px 0 6px;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 15px;
    background: var(--win-capsule);
    font: 600 12px var(--mono);
    white-space: nowrap;
  }

  .layer {
    padding: 2px 8px;
    border-radius: 10px;
    background: var(--accent-soft);
    color: var(--accent);
  }

  .faint {
    color: var(--faint);
  }

  .actions {
    display: flex;
    gap: 18px;
    padding-right: 6px;
    color: var(--dim);
    font-size: 12px;
    font-weight: 500;
  }

  .count {
    margin-left: 4px;
    padding: 0 6px;
    border-radius: 8px;
    background: var(--wash);
    color: var(--text);
    font-size: 11px;
  }

  .body {
    display: flex;
    min-height: 460px;
  }

  .tree {
    flex-shrink: 0;
    width: 230px;
    padding: 10px 8px;
    border-right: 1px solid var(--border);
    background: var(--win-side);
    font-size: 12.5px;
  }

  .tree div {
    display: flex;
    align-items: center;
    height: 26px;
    padding: 0 10px;
    border-radius: 6px;
    white-space: nowrap;
  }

  .tree .dir {
    color: var(--dim);
  }

  .tree .file {
    padding-left: 28px;
  }

  .tree .on {
    background: var(--accent-soft);
  }

  .m,
  .a {
    margin-left: auto;
    font: 600 11px var(--mono);
  }

  .m {
    color: var(--orange);
  }

  .a {
    color: var(--green);
  }

  .pane {
    flex: 1;
    min-width: 0;
    padding: 16px;
    background: var(--win-pane);
  }

  .card {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--win-card);
  }

  .header {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 40px;
    padding: 0 12px;
    border-bottom: 1px solid var(--border);
    font: 600 12.5px var(--mono);
  }

  .plus {
    color: var(--green);
  }

  .minus {
    color: var(--red);
  }

  .viewed {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-left: auto;
    color: var(--dim);
    font: 500 12px var(--sans);
  }

  .box {
    width: 13px;
    height: 13px;
    border: 1px solid var(--border-strong);
    border-radius: 3px;
    background: var(--win-card);
  }

  .lines {
    padding: 6px 0;
    overflow-x: auto;
  }

  .ln {
    display: flex;
    color: var(--code-text);
    font: 12.5px/22px var(--mono);
    white-space: pre;
  }

  .no {
    flex-shrink: 0;
    width: 40px;
    padding-right: 8px;
    color: var(--faint);
    text-align: right;
  }

  .sg {
    flex-shrink: 0;
    width: 18px;
    color: var(--faint);
    text-align: center;
  }

  .add {
    background: var(--diff-add);
  }

  .add .no {
    background: var(--diff-add-number);
  }

  .del {
    background: var(--diff-del);
  }

  .del .no {
    background: var(--diff-del-number);
  }

  .note {
    margin: 8px 16px 8px 58px;
    padding: 12px 14px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--win-note);
    box-shadow: 0 2px 8px rgb(0 0 0 / 6%);
    font-size: 13px;
    line-height: 1.5;
  }

  .note code {
    font-size: 12px;
  }

  .who {
    margin-bottom: 4px;
    color: var(--dim);
    font-size: 12px;
  }

  .who b {
    color: var(--text);
  }

  .status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 18px;
    height: 28px;
    padding: 0 14px;
    overflow: hidden;
    border-top: 1px solid var(--border);
    background: var(--win-chrome);
    color: var(--dim);
    font-size: 11.5px;
  }

  @media (max-width: 820px) {
    .tree,
    .actions {
      display: none;
    }

    .body {
      min-height: 0;
    }
  }
</style>

---
import '@fontsource-variable/geist'
import '@fontsource-variable/geist-mono'
import '../styles/landing.css'
import '../styles/window.css'
import { version } from '../../../package.json'
import AppWindow from '../components/AppWindow.astro'
import DiffDemo from '../components/demo/DiffDemo.tsx'
import { exportComments, exportLines } from '../components/demo/comments.ts'
import { goComment, layers, startLayer } from '../components/demo/fixtures.ts'
import InstallCommand from '../components/InstallCommand.astro'
import ThemeSelect from '../components/ThemeSelect.astro'

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/')
const repo = 'https://github.com/vmaerten/diffdesk'
const changelog = `${repo}/blob/main/CHANGELOG.md`
const guide = `${base}guide/getting-started/`
const description =
  'A native macOS diff viewer with a GitHub-like review flow: comment on your own changes, then hand the comments to your agent.'
const reviewed = layers[startLayer]!
const firstExport = exportLines(exportComments(reviewed, reviewed.comments))
const fullExport = exportLines(exportComments(reviewed, [goComment, ...reviewed.comments]))
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Diffdesk · Review the PR you are about to open</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="canonical" href={new URL(base, Astro.site)} />
    <meta property="og:title" content="Diffdesk" />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(base, Astro.site)} />
    {/* Same rule as Starlight's theme provider, inlined so the page never flashes the wrong theme. */}
    <script is:inline>
      ;(() => {
        let stored = ''
        try {
          stored = localStorage.getItem('starlight-theme') ?? ''
        } catch {}
        const light = matchMedia('(prefers-color-scheme: light)').matches
        document.documentElement.dataset.theme =
          stored === 'light' || stored === 'dark' ? stored : light ? 'light' : 'dark'
      })()
    </script>
  </head>
  <body>
    <header class="wrap top">
      <a href={base} class="brand"><img src={`${base}favicon.svg`} alt="" width="28" height="28" />Diffdesk</a>
      <nav aria-label="Main">
        <a href={guide}>guide</a>
        <a href={changelog}>changelog</a>
        <a href={repo} class="button">github ↗</a>
        <ThemeSelect />
      </nav>
    </header>

    <main>
      <section class="wrap hero">
        <div class="title">
          <p class="eyebrow">$ diffdesk</p>
          <h1>Review the PR you are about to open, without opening it.</h1>
        </div>
        <div class="intro">
          <p class="lede">
            A native macOS diff viewer for the work still on your machine. Comment on lines like on GitHub, then hand
            the comments back to whoever writes the code: you, or your agent.
          </p>
          <InstallCommand />
          <p class="requirements">{version} · macOS 13+ · Apple Silicon · Git · MIT</p>
        </div>
      </section>

      <section class="wrap section" aria-label="A Diffdesk review to try">
        <div class="stage">
          <DiffDemo client:only="react">
            <Fragment slot="fallback">
              <AppWindow />
              <div class="terminal">
                <div class="bar">
                  <span class="dot"></span><span class="dot"></span><span class="dot"></span>~/dev/api · stack-nav
                </div>
                <pre><span class="prompt">$</span> diffdesk comments{'\n'}{firstExport.map(({ line, heading }) => <span class={heading ? 'heading' : undefined}>{line}{'\n'}</span>)}</pre>
              </div>
            </Fragment>
          </DiffDemo>
        </div>
        <ul class="demo-hint" aria-label="Try it">
          <li><kbd class="kbd">+</kbd> comment a line</li>
          <li><kbd class="kbd">c</kbd> comment the selection</li>
          <li><span class="keys"><kbd class="kbd">j</kbd><kbd class="kbd">k</kbd></span> next, previous file</li>
          <li><kbd class="kbd">v</kbd> mark Viewed</li>
          <li><kbd class="kbd">s</kbd> pick a layer</li>
          <li><span class="keys"><kbd class="kbd">[</kbd><kbd class="kbd">]</kbd></span> layer below, above</li>
          <li><kbd class="kbd">⌘K</kbd> run a command</li>
          <li><kbd class="kbd">⌘P</kbd> go to a file</li>
          <li><kbd class="kbd">⌘</kbd> hover a name for its type, click for its definition</li>
        </ul>
        <p class="demo-terminal">The terminal prints what <code>diffdesk comments</code> would.</p>
      </section>

      <section class="wrap section">
        <p class="eyebrow">// the loop</p>
        <h2>Review the change before anyone else has to.</h2>
        <ol class="loop">
          <li>
            <p class="step">01 · write</p>
            You or your agent change the code. Nothing is committed yet.
          </li>
          <li class="arrow" aria-hidden="true">→</li>
          <li>
            <p class="step">02 · diffdesk</p>
            The branch against its base, working tree included, in one window.
          </li>
          <li class="arrow" aria-hidden="true">→</li>
          <li>
            <p class="step">03 · comment</p>
            Select lines, press <kbd class="kbd">c</kbd>. Fold what you read with <kbd class="kbd">v</kbd>.
          </li>
          <li class="arrow" aria-hidden="true">→</li>
          <li class="last">
            <p class="step">04 · hand back</p>
            <kbd class="kbd">⇧⌘C</kbd> copies the comments for your agent. Fix, run <code>diffdesk</code> again.
          </li>
        </ol>
      </section>

      <section class="band">
        <div class="wrap">
          <div class="copy">
            <p class="eyebrow">// for agents</p>
            <h2>Comments an agent can act on.</h2>
            <p>
              Each comment gives its ID, its lines and what to change. The agent reads the code in the file it edits,
              so Diffdesk only quotes the lines the file no longer has: removed by the change, or changed since you wrote
              the remark.
            </p>
            <p>
              <code>diffdesk comments resolve &lt;id&gt;</code> closes one once it is done, and <code>--json</code> gives
              the comments to a script.
            </p>
          </div>
          <pre class="export"><span class="prompt">$</span> diffdesk comments{'\n'}{fullExport.map(({ line, heading }) => <span class={heading ? 'heading' : undefined}>{line}{'\n'}</span>)}</pre>
        </div>
      </section>

      <section class="wrap section features-section">
        <p class="eyebrow">// features</p>
        <h2>Everything a review needs, nothing it does not.</h2>
        <div class="features">
          <div>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"></rect><path d="M12 4v16"></path></svg>
            <h3>Unified or split</h3>
            <p>A file tree in diff order, expandable context, and a search across the whole diff, not just what is on screen.</p>
          </div>
          <div>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="4" y="3" width="16" height="5" rx="1.5"></rect><rect x="4" y="10" width="16" height="5" rx="1.5"></rect><rect x="4" y="17" width="16" height="4" rx="1.5"></rect></svg>
            <h3>Stacks and bases</h3>
            <p>The base comes from your choice, the branch, or its gh stack chain. Step through layers with <kbd class="kbd">[</kbd> and <kbd class="kbd">]</kbd>.</p>
          </div>
          <div>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 5h14v10H9l-4 4z"></path></svg>
            <h3>Comments that last</h3>
            <p>Stored per branch in the checkout's .git folder. Resolve one when it is done: it leaves the diff and stays on record.</p>
          </div>
          <div>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="3"></rect><path d="M8 12l3 3 5-6"></path></svg>
            <h3>Viewed files</h3>
            <p>Press <kbd class="kbd">v</kbd> and the file folds away. Change its diff and the tick clears itself.</p>
          </div>
          <div>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 4C7 4 6 5 6 7v2c0 1.5-.8 2.5-2 3 1.2.5 2 1.5 2 3v2c0 2 1 3 3 3M15 4c2 0 3 1 3 3v2c0 1.5.8 2.5 2 3-1.2.5-2 1.5-2 3v2c0 2-1 3-3 3"></path></svg>
            <h3>Code intelligence <span class="beta">beta</span></h3>
            <p>Hold <kbd class="kbd">⌘</kbd> over a symbol for its type and docs, click to go to its definition. Answers come from the language servers on your Mac.</p>
          </div>
          <div>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="6" cy="6" r="2"></circle><circle cx="6" cy="18" r="2"></circle><circle cx="18" cy="18" r="2"></circle><path d="M6 8v8M18 16V9a3 3 0 0 0-3-3h-4M13 4l-2 2 2 2"></path></svg>
            <h3>Pull request and checks</h3>
            <p>The branch's GitHub pull request in the title bar: its state, its checks and what is not pushed yet, through the gh CLI you already use.</p>
          </div>
          <div>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 9V6a3 3 0 1 0-3 3h12a3 3 0 1 0-3-3v12a3 3 0 1 0 3-3H6a3 3 0 1 0 3 3V9"></path></svg>
            <h3>Command palette</h3>
            <p><kbd class="kbd">⌘K</kbd> finds a command by name, with its shortcut. <kbd class="kbd">⌘P</kbd> jumps to any file of the review.</p>
          </div>
          <div>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="8"></circle><path d="M8 12h8M12 8v8"></path></svg>
            <h3>Any comparison</h3>
            <p>Another branch without checking it out, a single commit, with or without untracked files and whitespace.</p>
          </div>
          <div>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="8"></circle><path d="M12 4a8 8 0 0 0 0 16z" fill="currentColor"></path></svg>
            <h3>Light, dark, your theme</h3>
            <p>Follows macOS, with a syntax theme for each mode and your code font. Image changes get before and after previews.</p>
          </div>
        </div>
      </section>

      <section class="wrap section reference">
        <div class="usage-column">
          <p class="eyebrow">// usage</p>
          <h2>One command, a few flags.</h2>
          <dl class="usage">
            <div><dt>diffdesk</dt><dd>The current branch, uncommitted work included.</dd></div>
            <div><dt>diffdesk feature</dt><dd>Another revision, without checking it out.</dd></div>
            <div><dt>diffdesk --base main</dt><dd>The comparison base. Otherwise gh stack or the trunk.</dd></div>
            <div><dt>diffdesk --repo ../other</dt><dd>Another checkout.</dd></div>
            <div><dt>diffdesk comments</dt><dd>The comments, compact for an agent.</dd></div>
            <div><dt>diffdesk comments resolve &lt;id&gt;</dt><dd>Close a comment once it is done.</dd></div>
          </dl>
        </div>
        <div class="keys-column">
          <p class="eyebrow">// keys</p>
          <h2>Hands stay on the keyboard.</h2>
          <ul class="keys">
            <li><kbd class="kbd">j</kbd><kbd class="kbd">k</kbd> next, previous file</li>
            <li><kbd class="kbd">v</kbd> toggle Viewed</li>
            <li><kbd class="kbd">c</kbd> comment lines</li>
            <li><kbd class="kbd">b</kbd><kbd class="kbd">t</kbd> base, target</li>
            <li><kbd class="kbd">[</kbd><kbd class="kbd">]</kbd> stack layers</li>
            <li><kbd class="kbd">⌘</kbd><kbd class="kbd">K</kbd> command palette</li>
            <li><kbd class="kbd">⌘</kbd><kbd class="kbd">P</kbd> go to a file</li>
            <li><kbd class="kbd">⌘</kbd><kbd class="kbd">F</kbd> search the diff</li>
            <li><kbd class="kbd">⌘</kbd> click go to definition</li>
            <li><kbd class="kbd">⇧</kbd><kbd class="kbd">⌘</kbd><kbd class="kbd">C</kbd> copy comments</li>
          </ul>
        </div>
      </section>

      <section class="wrap closing">
        <div class="cta">
          <div>
            <h2>Review before you push.</h2>
            <p>Free and open source under the MIT license. Needs macOS 13 or later on Apple Silicon, and Git.</p>
          </div>
          <div class="commands">
            <code><span class="prompt">$</span> brew install --cask vmaerten/tap/diffdesk</code>
            <code><span class="prompt">$</span> mise use -g github:vmaerten/diffdesk@latest</code>
          </div>
        </div>
      </section>
    </main>

    <footer class="wrap">
      <div class="bottom">
        <span>Diffdesk · MIT · vmaerten/diffdesk</span>
        <nav aria-label="Footer">
          <a href={guide}>guide</a><a href={changelog}>changelog</a><a href={repo}>github ↗</a>
        </nav>
      </div>
    </footer>
  </body>
</html>

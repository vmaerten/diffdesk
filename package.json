{
  "name": "ghl",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Review the PR you are about to open, without opening it",
  "bin": {
    "ghl": "./bin/ghl.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "ghl": "node ./bin/ghl.ts",
    "install:local": "pnpm build && node scripts/install.ts",
    "uninstall:local": "node scripts/install.ts --uninstall",
    "test": "pnpm build && node ./test/run.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint bin scripts src test web/src vite.config.js",
    "lint:fix": "oxlint --fix bin scripts src test web/src vite.config.js",
    "format": "oxfmt bin scripts src test web/src vite.config.js",
    "format:check": "oxfmt --check bin scripts src test web/src vite.config.js",
    "go:build": "task build",
    "go:test": "task test",
    "go:vet": "task vet",
    "poc:go:build": "task poc:build",
    "poc:go:test": "task poc:test",
    "poc:go:bench": "pnpm build && pnpm poc:go:build && python3 scripts/bench-runtime/run.py --go-poc"
  },
  "dependencies": {
    "@pierre/diffs": "^1.3.5",
    "@pierre/trees": "1.0.0-beta.6",
    "cmdk": "^1.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.1",
    "oxc-transform-react": "^0.145.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "puppeteer-core": "^25.5.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
